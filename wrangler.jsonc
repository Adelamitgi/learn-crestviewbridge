{
  // Cloudflare Workers Builds runs `npx wrangler deploy` on every push to main.
  // Static files only: ./public is served as is, no Worker script runs.
  "name": "learn-crestviewbridge",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // Only learn.crestviewbridge.net (custom domain, added in the dashboard) serves the site.
  "workers_dev": false,
  // No extra public preview addresses for each version.
  "preview_urls": false,
  // Keep request logs off: the privacy notice says no logging is used.
  "observability": { "enabled": false }
}
